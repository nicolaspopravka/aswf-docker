#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "World"
{
    def Camera "Camera"
    {
        float focalLength = 50
        float horizontalAperture = 20.955
        double3 xformOp:translate = (0, 0, 5)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Sphere "BlueSphere" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </World/Looks/Blue>
        double radius = 1
    }

    def Sphere "RedSphere" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </World/Looks/Red>
        double radius = 1
        double3 xformOp:translate = (0, 0, 10)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def DistantLight "KeyLight"
    {
        color3f inputs:color = (1, 0.95, 0.9)
        float inputs:intensity = 1000
        float inputs:angle = 0.5
        float3 xformOp:rotateXYZ = (-25, 35, 0)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }

    def DomeLight "DiagnosticBackground"
    {
        color3f inputs:color = (0.04, 0.08, 0.02)
        float inputs:intensity = 1
    }

    def Scope "Looks"
    {
        def Material "Blue"
        {
            token outputs:surface.connect = </World/Looks/Blue/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.03, 0.2, 0.8)
                float inputs:metallic = 0
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }

        def Material "Red"
        {
            token outputs:surface.connect = </World/Looks/Red/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.03, 0.03)
                float inputs:metallic = 0
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }
    }
}
