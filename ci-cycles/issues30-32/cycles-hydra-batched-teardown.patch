diff --git a/src/hydra/session.cpp b/src/hydra/session.cpp
index ae1ede13b..a327c40c4 100644
--- a/src/hydra/session.cpp
+++ b/src/hydra/session.cpp
@@ -91,0 +92 @@ HdCyclesSession::~HdCyclesSession()
+    /* Scene destruction releases all remaining nodes in dependency order. */
@@ -93,0 +95,26 @@ HdCyclesSession::~HdCyclesSession()
+  else {
+    const SceneLock lock(this);
+    FlushDeferredDeletions();
+  }
+}
+
+void HdCyclesSession::DeferGeometryDeletion(const std::vector<Object *> &objects,
+                                            Geometry *geometry)
+{
+  _objectsToDelete.insert(objects.begin(), objects.end());
+  _geometryToDelete.insert(geometry);
+}
+
+void HdCyclesSession::FlushDeferredDeletions()
+{
+  Scene *const scene = session->scene.get();
+
+  /* Delete objects before the geometry they reference. */
+  if (!_objectsToDelete.empty()) {
+    scene->delete_nodes(_objectsToDelete);
+    _objectsToDelete.clear();
+  }
+  if (!_geometryToDelete.empty()) {
+    scene->delete_nodes(_geometryToDelete);
+    _geometryToDelete.clear();
+  }
@@ -97,0 +125,2 @@ void HdCyclesSession::UpdateScene()
+  FlushDeferredDeletions();
+
