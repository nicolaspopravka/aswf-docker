+static array<int> FindUdimTiles(const SdfAssetPath &assetPath)
+{
+  const std::string &resolvedPath = assetPath.GetResolvedPath();
+  const std::string filename = resolvedPath.empty() ? assetPath.GetAssetPath() : resolvedPath;
+  const std::string::size_type udimPos = filename.find("<UDIM>");
+  if (udimPos == std::string::npos) {
+    return {};
+  }
+
+  ArResolverScopedCache resolverCache;
+  ArResolver &resolver = ArGetResolver();
+  array<int> tiles;
+  for (int tile = 1001; tile <= 1100; ++tile) {
+    std::string tileFilename = filename;
+    tileFilename.replace(udimPos, 6, std::to_string(tile));
+    if (!resolver.Resolve(tileFilename).empty()) {
+      tiles.push_back_slow(tile);
+    }
+  }
+  return tiles;
+}
