# syntax=docker/dockerfile:1

ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ARG BASE_IMAGE
ARG BUILD_PATH
ARG CY
ARG OPENUSD_VERSION
ARG MATERIALX_VERSION
ARG PYTHON_VERSION
ARG PYTHON_SHA256
ARG SOURCE_REVISION
ARG SOURCE_SHA256
ARG SCRIPT_SHA256
ARG EXPECTED_GCC_MAJOR
ARG INSTALL_PREFIX
ARG BUILD_JOBS=4
ARG ASWF_SOURCE_COMMIT
ARG WORKFLOW_REVISION
ARG DEBUG_BUILD=0
ARG PTEX_BUFFER_PATCH_SHA256
ARG SOURCE_REPOSITORY=https://github.com/PixarAnimationStudios/OpenUSD

COPY build_openusd_path_image.sh /opt/openusd-matrix/build_openusd_path_image.sh
COPY aswf-build_usd.sh /opt/openusd-matrix/aswf-build_usd.sh
COPY run_moana_storm_debug.sh /opt/moana-debug/run_moana_storm_debug.sh
COPY run_ptex_validator.sh /opt/moana-debug/run_ptex_validator.sh
COPY openusd-ptex-buffer-size-overflow.patch /opt/openusd-matrix/openusd-ptex-buffer-size-overflow.patch
COPY test_openusd_ptex_buffer_size.cpp /opt/openusd-matrix/test_openusd_ptex_buffer_size.cpp
COPY validate_ptex_file.cpp /opt/openusd-matrix/validate_ptex_file.cpp

RUN dnf install -y \
      gdb \
      binutils \
      "gcc-toolset-${EXPECTED_GCC_MAJOR}-libasan-devel" \
      "gcc-toolset-${EXPECTED_GCC_MAJOR}-libubsan-devel" \
    && dnf clean all \
    && chmod 0755 \
      /opt/openusd-matrix/build_openusd_path_image.sh \
      /opt/openusd-matrix/aswf-build_usd.sh \
      /opt/moana-debug/run_moana_storm_debug.sh \
      /opt/moana-debug/run_ptex_validator.sh \
    && /opt/openusd-matrix/build_openusd_path_image.sh build

ENV OPENUSD_MATRIX_BUILD_PATH=${BUILD_PATH} \
    OPENUSD_MATRIX_CY=${CY} \
    OPENUSD_MATRIX_PREFIX=${INSTALL_PREFIX} \
    PATH=${INSTALL_PREFIX}/bin:${PATH} \
    PYTHONPATH=${INSTALL_PREFIX}/lib/python \
    LD_LIBRARY_PATH=${INSTALL_PREFIX}/lib \
    PXR_PLUGINPATH_NAME=${INSTALL_PREFIX}/plugin/usd \
    PXR_MTLX_STDLIB_SEARCH_PATHS=${INSTALL_PREFIX}/share/MaterialX

LABEL org.opencontainers.image.source="https://github.com/nicolaspopravka/aswf-docker" \
      org.opencontainers.image.revision="${WORKFLOW_REVISION}" \
      org.opencontainers.image.title="OpenUSD ${OPENUSD_VERSION} Moana RelWithDebInfo diagnostic" \
      io.openusd-moana-debug.build-variant="relwithdebuginfo" \
      io.openusd-moana-debug.ptex="enabled" \
      io.openusd-moana-debug.openvdb="enabled" \
      io.openusd-moana-debug.ptex-buffer-patch-sha256="${PTEX_BUFFER_PATCH_SHA256}" \
      io.openusd-matrix.build-path="${BUILD_PATH}" \
      io.openusd-matrix.cy="${CY}" \
      io.openusd-matrix.openusd-version="${OPENUSD_VERSION}" \
      io.openusd-matrix.materialx-version="${MATERIALX_VERSION}" \
      io.openusd-matrix.python-version="${PYTHON_VERSION}" \
      io.openusd-matrix.python-source-sha256="${PYTHON_SHA256}" \
      io.openusd-matrix.base-image="${BASE_IMAGE}" \
      io.openusd-matrix.source-repository="${SOURCE_REPOSITORY}" \
      io.openusd-matrix.source-revision="${SOURCE_REVISION}" \
      io.openusd-matrix.source-sha256="${SOURCE_SHA256}" \
      io.openusd-matrix.script-sha256="${SCRIPT_SHA256}" \
      io.openusd-matrix.aswf-source-commit="${ASWF_SOURCE_COMMIT}" \
      io.openusd-matrix.install-prefix="${INSTALL_PREFIX}"
